# Vercel / Neon environment variables — copy names into Vercel dashboard.
#
# Neon + Prisma (pooler): runtime queries REQUIRE pgbouncer mode on the pooled URL.
# - DATABASE_URL = Neon "pooled" / -pooler- host WITH:
#     ?sslmode=require&pgbouncer=true&connection_limit=1
#   (append &… if other params exist; avoid channel_binding on Vercel if problems)
# - DIRECT_URL   = Neon "direct" connection (hostname WITHOUT "-pooler-") —
#                   used only by prisma migrate deploy at build time.
#
# Get both strings from Neon: Connect → pooled vs direct (show password → copy).

DATABASE_URL=

DIRECT_URL=

JWT_SECRET=

DEFAULT_ADMIN_USERNAME=

DEFAULT_ADMIN_PASSWORD=

OMDB_API_KEY=

TMDB_API_KEY=

TMDB_ACCESS_TOKEN=

TMDB_WATCH_REGION=
